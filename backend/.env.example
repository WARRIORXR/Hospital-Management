[TEMPLATE]
DATABASE_URL=postgresql://username:password@host:5432/database_name
FRONTEND_ORIGINS=https://your-app.vercel.app

# Portal authentication (admin / hospital / staff employee-code + PIN login).
# Accounts are created on startup when the employee code does not exist yet.
# Set AUTH_SECRET to a long random value in production; without it each
# process generates an ephemeral secret and sessions die on restart.
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_CODE=ADM-001
ADMIN_PIN=123456
HOSPITAL_CODE=HOSP-001
HOSPITAL_PIN=123456
STAFF_CODE=DR-101
STAFF_PIN=123456

# Patient OTP verification (prototype echoes the code in the API response).
OTP_DEBUG=true
