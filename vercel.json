{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "queueless-api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "pip install -r requirements.txt"
    },
    "queueless-web": {
      "root": "frontend",
      "framework": "nextjs",
      "buildCommand": "npm ci && npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "queueless-api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "queueless-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "queueless-web"
      }
    }
  ]
}
